# =====================================================================
# Environment template for docker-compose. Copy to `.env` and fill in.
#   cp .env.example .env
#
# The committed `.env` holds SAFE LOCAL-DEMO defaults so `docker compose up`
# works out of the box. For a PUBLIC / production deploy you MUST override the
# secrets below with real values — provided via the deploy environment or a
# secrets manager, NOT committed to git.
# =====================================================================

# --- Database credentials (shared by all PostgreSQL instances) ---
DB_USER=ticketflow
DB_PASSWORD=change-me-in-production

# --- JWT signing secret (auth-service signs, gateway verifies) ---
# Must be a long, random, secret string (>= 32 bytes). Anyone who knows it can
# forge valid tokens, so treat it like a password. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-generate-a-strong-random-secret
JWT_EXPIRATION_MS=86400000

# --- HikariCP pool size (optional tuning) ---
DB_POOL_MAX=30

# --- Email (SMTP) overrides live in .env.local (git-ignored) ---
# See .env.local.example for Gmail/MailHog settings.
