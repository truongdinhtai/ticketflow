# Copy to terraform.tfvars and fill in. Do NOT commit real values.
aws_region       = "us-east-1"
instance_type    = "t3.large"          # 8GB — fits the full stack; t3.medium for a subset
ssh_public_key   = "ssh-ed25519 AAAA... you@host"   # contents of your ~/.ssh/id_ed25519.pub
allowed_ssh_cidr = "YOUR.IP.ADD.RESS/32"            # tighten from 0.0.0.0/0

# Provide the DB password via environment instead of committing it:
#   export TF_VAR_db_password='a-strong-password'
