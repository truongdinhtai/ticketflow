# =====================================================================
# Real email (SMTP) overrides for Notification Service.
#
# HOW TO USE
#   1. Copy this file to `.env.local`  (it is git-ignored — secrets stay local)
#        cp .env.local.example .env.local
#   2. Fill in the values below (see Gmail steps).
#   3. Start the stack loading BOTH env files:
#        docker compose --env-file .env --env-file .env.local up -d
#
# Without .env.local the stack defaults to MailHog (no real email is sent).
# =====================================================================

# ---- Gmail example ----
# Requires 2-Step Verification enabled, then an "App Password" (16 chars):
#   https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your.address@gmail.com
MAIL_PASSWORD=your16charapppassword
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# From address (Gmail sends as your authenticated account regardless):
MAIL_FROM=your.address@gmail.com
