# =====================================================================
# Environment variables consumed by docker-compose.yml.
# These are SAFE LOCAL DEMO DEFAULTS only — never use in production.
# Real secrets belong in .env.local (git-ignored) or a secret manager.
# =====================================================================

# --- Database credentials (one Postgres container per service) ---
POSTGRES_USER=ticketflow
POSTGRES_PASSWORD=ticketflow

EVENT_DB_NAME=event_db
BOOKING_DB_NAME=booking_db
NOTIFICATION_DB_NAME=notification_db

# --- Host ports exposed for convenience while developing locally ---
CONFIG_SERVER_PORT=8888
DISCOVERY_SERVER_PORT=8761
API_GATEWAY_PORT=8080

EVENT_SERVICE_PORT=8081
BOOKING_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083

ZIPKIN_PORT=9411
KAFKA_PORT=9092
