# Shared database credentials for all three PostgreSQL instances.
DB_USER=ticketflow
DB_PASSWORD=ticketflow

# --- Host ports (for reference; fixed in docker-compose.yml) ---
# config-server 8888 | discovery 8761 | gateway 8080
# event 8081 | booking 8082 | notification 8083
# zipkin 9411 | kafka 9092 | mailhog UI 8025 / SMTP 1025
# postgres (host): event 5433 | booking 5434 | notification 5435
